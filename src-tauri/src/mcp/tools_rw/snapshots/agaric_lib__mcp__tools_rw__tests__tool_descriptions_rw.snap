---
source: src/mcp/tools_rw/tests.rs
expression: wire
---
- description: "Append a content block under an existing parent. The block_type is always `content` — agents cannot create pages or tags through this tool."
  inputSchema:
    additionalProperties: false
    properties:
      content:
        description: Markdown content for the new block.
        type: string
      parent_id:
        description: ULID of the parent block (required — no orphan blocks).
        type: string
      position:
        description: Optional 1-based sibling position. Defaults to append (end).
        minimum: 1
        type: integer
      space_id:
        description: "ULID of the space the agent is operating in. The append is rejected with a Validation error if `parent_id`'s owning page lives in a different space."
        type: string
    required:
      - parent_id
      - content
      - space_id
    type: object
  name: append_block
- description: Replace the content of an existing block. Reversible via page history.
  inputSchema:
    additionalProperties: false
    properties:
      block_id:
        description: ULID of the block to edit.
        type: string
      content:
        description: New Markdown content.
        type: string
      space_id:
        description: "ULID of the space the agent is operating in. The edit is rejected with a Validation error if `block_id`'s owning page lives in a different space."
        type: string
    required:
      - block_id
      - content
      - space_id
    type: object
  name: update_block_content
- description: "Set (upsert) a typed property on a block. Exactly one of value_text / value_num / value_date / value_ref / value_bool must be provided. The task keys behave as in the app: `todo_state` and `priority` take value_text, `due_date` and `scheduled_date` take value_date, and `todo_state = DONE` stamps `completed_at` and creates a repeating task's next occurrence."
  inputSchema:
    additionalProperties: false
    properties:
      block_id:
        description: ULID of the target block.
        type: string
      key:
        description: "Property key (see list_property_defs). The reserved key `space` is rejected — space membership is not a content property."
        type: string
      space_id:
        description: "ULID of the space the agent is operating in. The write is rejected with a Validation error if `block_id`'s owning page lives in a different space."
        type: string
      value_bool:
        description: "Boolean value (exactly one value_* must be set). #697 — for `value_type = 'boolean'` property definitions."
        type: boolean
      value_date:
        description: ISO-8601 date (exactly one value_* must be set).
        type: string
      value_num:
        description: Numeric value (exactly one value_* must be set).
        type: number
      value_ref:
        description: Block ULID reference (exactly one value_* must be set).
        type: string
      value_text:
        description: Text value (exactly one value_* must be set).
        type: string
    required:
      - block_id
      - key
      - space_id
    type: object
  name: set_property
- description: "Apply an existing tag to a block. The tag block must already exist — `create_tag` makes one."
  inputSchema:
    additionalProperties: false
    properties:
      block_id:
        description: ULID of the block to tag.
        type: string
      space_id:
        description: "ULID of the space the agent is operating in. The tag application is rejected with a Validation error if `block_id`'s owning page lives in a different space. `tag_id` must be a tag of the same space."
        type: string
      tag_id:
        description: ULID of an existing tag block.
        type: string
    required:
      - block_id
      - tag_id
      - space_id
    type: object
  name: add_tag
- description: "Create a new top-level page with the given title in the given space, or, when a live page with that title already exists in the space, return that page's id. The page has no parent (pages are always top-level in Agaric's model) and lands with its `space` property set in a single transaction."
  inputSchema:
    additionalProperties: false
    properties:
      space_id:
        description: "ULID of the space the new page belongs to. Required: every page lives in exactly one space; a page created without a `space_id` would be invisible to every space-scoped query."
        type: string
      title:
        description: "Page title (becomes the page's content)."
        type: string
    required:
      - title
      - space_id
    type: object
  name: create_page
- description: Soft-delete a block and its descendants. Reversible via page history (agents never get the non-reversible purge path).
  inputSchema:
    additionalProperties: false
    properties:
      block_id:
        description: ULID of the block to soft-delete.
        type: string
      space_id:
        description: "ULID of the space the agent is operating in. The delete is rejected with a Validation error if `block_id`'s owning page lives in a different space."
        type: string
    required:
      - block_id
      - space_id
    type: object
  name: delete_block
- description: "List every space as { id, name, is_default }. Every read-write tool (and search / journal_for_date) requires a space_id — call this first to discover one. is_default marks the seeded Personal space, the sensible fallback when no space has been chosen."
  inputSchema:
    additionalProperties: false
    properties: {}
    type: object
  name: list_spaces
- description: "Append a Markdown outline under an existing parent in one call, as one undo, exactly as a paste in the app lands it: list items nest by indentation, a heading outside a list owns what follows it, a fenced code block stays one block, a `- [ ]` checkbox is a task, and `key:: value` lines are properties. A `[[Name]]` or `#name` that matches no page or tag in the parent's space creates that page or tag there. A call that would write more than 1000 operations is refused; split it."
  inputSchema:
    additionalProperties: false
    properties:
      markdown:
        description: The Markdown outline to append.
        type: string
      parent_id:
        description: ULID of the parent block or page the outline lands under.
        type: string
      position:
        description: Optional 1-based sibling position of the first top-level block. Defaults to append (end).
        minimum: 1
        type: integer
      space_id:
        description: "ULID of the space the agent is operating in. The append is rejected with a Validation error if `parent_id`'s owning page lives in a different space."
        type: string
    required:
      - parent_id
      - markdown
      - space_id
    type: object
  name: append_markdown
- description: "Move a page, with its content blocks, to another space. Reversible via page history."
  inputSchema:
    additionalProperties: false
    properties:
      page_id:
        description: ULID of the page to move. Only page blocks move; a content block stays with its page.
        type: string
      space_id:
        description: "ULID of the space the agent is operating in. The move is rejected with a Validation error if `page_id` lives in a different space."
        type: string
      target_space_id:
        description: ULID of the live space to move the page into (see list_spaces).
        type: string
    required:
      - page_id
      - space_id
      - target_space_id
    type: object
  name: move_page_to_space
- description: "Create a tag in the given space, or, when the space already has a live tag with that name, return that tag. Apply it with add_tag."
  inputSchema:
    additionalProperties: false
    properties:
      name:
        description: "Tag name (becomes the tag's content)."
        type: string
      space_id:
        description: ULID of the space the tag belongs to.
        type: string
    required:
      - name
      - space_id
    type: object
  name: create_tag
- description: "Delete a property from a block. Reversible via page history. The task keys behave as in the app: deleting `todo_state` un-tasks the block, and deleting `repeat` removes its end conditions too. The bookkeeping keys `created_at`, `completed_at`, `repeat-seq` and `repeat-origin` are refused."
  inputSchema:
    additionalProperties: false
    properties:
      block_id:
        description: ULID of the target block.
        type: string
      key:
        description: "Property key to delete. The reserved key `space` is rejected — use move_page_to_space."
        type: string
      space_id:
        description: "ULID of the space the agent is operating in. The delete is rejected with a Validation error if `block_id`'s owning page lives in a different space."
        type: string
    required:
      - block_id
      - key
      - space_id
    type: object
  name: delete_property
