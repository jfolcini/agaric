---
source: src/mcp/tools_ro/tests.rs
expression: wire
---
- description: "List the pages of a space, sorted and filtered, with cursor pagination. Each row is the page's block row (`content` is its title) plus `last_modified_at` (epoch ms), `inbound_link_count` and `child_block_count`; the first page also carries `total_count`."
  inputSchema:
    additionalProperties: false
    properties:
      cursor:
        description: Opaque pagination cursor from a prior response.
        type: string
      filters:
        description: "Primitives, all of which a page must match: {type: Orphan} (no links in or out), {type: HasNoInboundLinks}, {type: Stub} (no blocks but its title), {type: Tag, tag} (attached tag ULID), {type: TagOrRef, tag} (attached or inline), {type: PathGlob, pattern, exclude} (title GLOB), {type: LastEdited, spec} (spec: Rolling {days}, OlderThan {days} or Range {start, end}), {type: HasProperty, key, predicate} and {type: Priority, values}, in the `query` tool's shapes. Any other primitive is refused."
        items:
          type: object
        type: array
      limit:
        description: Max pages per response (capped at 100).
        maximum: 100
        minimum: 1
        type: integer
      sort:
        description: "Title A-Z (the default), last edit newest first, most inbound links, most blocks, or creation order (`default`). A cursor only continues the sort it came from."
        enum:
          - alphabetical
          - recently-modified
          - most-linked
          - most-content
          - default
        type: string
      space_id:
        description: ULID of the space whose pages to list.
        type: string
    required:
      - space_id
    type: object
  name: list_pages
- description: "Fetch a page and a paginated slice of its non-conflict subtree (grandchildren included). `page` also carries `properties` (every property row, raw), `tags` (tag ULIDs; `list_tags` names them) and `aliases`; the children are plain rows. A slice whose content passes 65536 bytes stops early with `truncated: true`; pass `next_cursor` as `cursor` to read on."
  inputSchema:
    additionalProperties: false
    properties:
      cursor:
        description: Opaque cursor for the children page.
        type: string
      limit:
        description: Max children per response (capped at 100).
        maximum: 100
        minimum: 1
        type: integer
      page_id:
        description: ULID of the page block.
        type: string
      space_id:
        description: ULID of the space the page belongs to. A page in another space is rejected with a Validation error.
        type: string
    required:
      - page_id
      - space_id
    type: object
  name: get_page
- description: "Search one space's blocks by text. `query` is not raw FTS5: every word must appear, as a case-insensitive substring; `\"a phrase\"` matches as written; `OR` and `NOT` between terms combine them. Words and phrases under 3 characters are dropped (the index is trigram), so a query of only short words finds nothing. Hits come best match first. An empty `query` with at least one of `parent_id`, `tag_ids` or `filter` returns the blocks those match, newest first; with none it returns nothing. Rows carry `page_title` (a page's own is its `content`) and a `snippet` with <mark> around the matches; `content` is cut to 512 chars, and null fields are left out. `filter` narrows further (state / priority / due / scheduled / last edited / property / page-name globs / block type / case-sensitive / whole-word / regex)."
  inputSchema:
    additionalProperties: false
    properties:
      cursor:
        type: string
      filter:
        additionalProperties: false
        description: "Structured filter set mirroring the user-facing `SearchFilter` (omit for a query-string-only search)."
        properties:
          block_type_filter:
            description: "Restrict to a single `blocks.block_type` value (e.g. `'page'`)."
            type: string
          case_sensitive:
            type: boolean
          due_filter:
            description: "Date predicate on `blocks.due_date`. One of `{ \"named\": \"today\"|\"this-week\"|... }` or `{ \"op\": { \"op\": \"lt\"|..., \"date\": \"YYYY-MM-DD\" } }`."
            type: object
          exclude_page_globs:
            description: Page-name glob exclude list.
            items:
              type: string
            type: array
          excluded_priority_filter:
            items:
              type: string
            type: array
          excluded_property_filters:
            items:
              properties:
                key:
                  type: string
                value:
                  type: string
              required:
                - key
                - value
              type: object
            type: array
          excluded_state_filter:
            description: "`(todo_state IS NULL OR todo_state NOT IN (...))`. Adding literal `'none'` excludes the NULL bucket too, AND-joining to `(todo_state IS NOT NULL AND todo_state NOT IN (...))`; `'none'` alone emits `todo_state IS NOT NULL`."
            items:
              type: string
            type: array
          include_page_globs:
            description: "Page-name glob include list (SQLite GLOB syntax, `{a,b}` brace expansion). Bare tokens are wrapped with `*…*`."
            items:
              type: string
            type: array
          is_regex:
            description: "Treat `query` as a regex (FTS5 bypassed)."
            type: boolean
          last_edited:
            description: "When the block was last edited: `{ \"type\": \"Rolling\", \"days\": N }` (within the last N days), `{ \"type\": \"OlderThan\", \"days\": N }`, or `{ \"type\": \"Range\", \"start\": \"YYYY-MM-DD\", \"end\": \"YYYY-MM-DD\" }` (both days included)."
            type: object
          priority_filter:
            items:
              type: string
            type: array
          property_filters:
            description: "AND-joined property predicates. Matches across `value_text` / `value_num` / `value_date` / `value_ref` with type coercion."
            items:
              properties:
                key:
                  type: string
                value:
                  type: string
              required:
                - key
                - value
              type: object
            type: array
          scheduled_filter:
            description: "Same shape as `due_filter` but on `blocks.scheduled_date`."
            type: object
          state_filter:
            description: "`todo_state IN (...)`. Literal `'none'` means `todo_state IS NULL`."
            items:
              type: string
            type: array
          whole_word:
            type: boolean
        type: object
      include_match_offsets:
        description: "Add each row's `match_offsets` (UTF-16 offsets into `content`). Only case_sensitive, whole_word and is_regex searches fill them."
        type: boolean
      limit:
        description: Max results per response (capped at 50).
        maximum: 50
        minimum: 1
        type: integer
      parent_id:
        description: "Only the direct children of this block, not deeper descendants: a ULID, or a page's title or alias."
        type: string
      query:
        description: Words to find; empty for a filter-only search.
        type: string
      space_id:
        description: "ULID of the space the search runs inside. Required: every FTS5 hit is restricted to blocks whose owning page carries `space = ?space_id`."
        type: string
      tag_ids:
        description: "Tag ULIDs or names. A block must carry every one: attached, as an inline #tag, or inherited from an ancestor such as its page."
        items:
          type: string
        type: array
    required:
      - query
      - space_id
    type: object
  name: search
- description: "Fetch a single block by ULID. Returns the BlockRow plus `properties` (every property row, raw), `tags` (tag ULIDs; `list_tags` names them) and, for a page, `aliases`; soft-deleted (tombstoned) blocks are excluded."
  inputSchema:
    additionalProperties: false
    properties:
      block_id:
        description: ULID of the block.
        type: string
      space_id:
        description: ULID of the space the block belongs to. A block in another space is rejected with a Validation error.
        type: string
    required:
      - block_id
      - space_id
    type: object
  name: get_block
- description: "List backlinks for a block, grouped by source page. A response whose content passes 65536 bytes stops at a group with `truncated: true`; pass `next_cursor` as `cursor` to read on."
  inputSchema:
    additionalProperties: false
    properties:
      block_id:
        description: ULID of the target block/page.
        type: string
      cursor:
        type: string
      limit:
        description: Max grouped results per response (capped at 100).
        maximum: 100
        minimum: 1
        type: integer
      space_id:
        description: ULID of the space to scope backlinks to.
        type: string
    required:
      - block_id
      - space_id
    type: object
  name: list_backlinks
- description: "List the tags of a space, with cursor pagination."
  inputSchema:
    additionalProperties: false
    properties:
      cursor:
        description: Opaque pagination cursor from a prior response.
        type: string
      limit:
        description: Max tags per response (capped at 100).
        maximum: 100
        minimum: 1
        type: integer
      space_id:
        description: ULID of the space whose tags to list.
        type: string
    required:
      - space_id
    type: object
  name: list_tags
- description: "List every property definition (typed property schema), with cursor pagination."
  inputSchema:
    additionalProperties: false
    properties:
      cursor:
        description: Opaque pagination cursor from a prior response.
        type: string
      limit:
        description: Max definitions per response (capped at 100).
        maximum: 100
        minimum: 1
        type: integer
    type: object
  name: list_property_defs
- description: "Agenda for an inclusive date range: every block whose due or scheduled date falls in the range (done tasks excluded), plus each later occurrence of a repeating task in the range. One row per (date, block, source): `source` names the date field (`due_date` or `scheduled_date`); `projected` is false for the block's own date and true for a later occurrence of a repeating task."
  inputSchema:
    additionalProperties: false
    properties:
      cursor:
        description: "Opaque cursor returned by a previous response's `next_cursor` to fetch the next page."
        type: string
      end_date:
        description: Inclusive YYYY-MM-DD upper bound.
        type: string
      limit:
        description: Max entries per response (capped at 500).
        maximum: 500
        minimum: 1
        type: integer
      space_id:
        description: ULID of the space to scope the agenda to.
        type: string
      start_date:
        description: Inclusive YYYY-MM-DD lower bound.
        type: string
    required:
      - start_date
      - end_date
      - space_id
    type: object
  name: get_agenda
- description: "Creates the page if missing and `date` is within ~12 months of today (one `CreateBlock` op with origin `agent:<name>`), then returns the journal page for `space_id` on `date`. Idempotent per `(space_id, date)` after the first call. Outside that ~12-month window this tool never creates: an existing page is returned as a pure read, and a missing one returns a not-found error."
  inputSchema:
    additionalProperties: false
    properties:
      date:
        description: YYYY-MM-DD date string.
        type: string
      space_id:
        description: ULID of the space the daily journal belongs to.
        type: string
    required:
      - date
      - space_id
    type: object
  name: journal_for_date
- description: "List every space as { id, name, is_default }. Every other tool except list_property_defs requires a space_id — call this first to discover one. is_default marks the seeded Personal space."
  inputSchema:
    additionalProperties: false
    properties: {}
    type: object
  name: list_spaces
- description: "Read a page as Markdown, returned as { page_id, markdown, truncated, next_cursor }: a `# Title` line, YAML front matter with the page's aliases, tags and properties, then the block outline with each block's `key:: value` properties under it. Links, tags and ref-typed values are written as names, for reading; a name can be ambiguous, so write links by ULID (`[[ULID]]`, `#[ULID]`). Each block ends with `^ULID`, the block_id update_block_content takes. Past 65536 bytes the Markdown stops at a block with `truncated: true`; pass `next_cursor` as `cursor` for the rest, which carries on from that block. With `editable: true`, `markdown` is instead the page's whole source, never truncated, the text the read-write server's edit_page_markdown takes back: no title line, a name only where it reads back as the same link, ref-typed values as ULIDs, and each block's `^ULID`."
  inputSchema:
    additionalProperties: false
    properties:
      cursor:
        description: "The `next_cursor` of a truncated read, to continue it."
        type: string
      editable:
        description: Return the source edit_page_markdown takes instead. Defaults to false.
        type: boolean
      page_id:
        description: ULID of the page block.
        type: string
      space_id:
        description: ULID of the space the page belongs to. A page in another space is rejected with a Validation error.
        type: string
    required:
      - page_id
      - space_id
    type: object
  name: get_page_markdown
- description: "Who changed what on a page, and when: every op on the page's blocks. Each row has device_id, seq, origin (`user`, or `agent:<name>` for an agent's write), op_type, created_at (epoch ms), block_id, a clipped `after` (the text or property value the op wrote) and, for an edit, a clipped `before`. Newest first; cursor paginated."
  inputSchema:
    additionalProperties: false
    properties:
      cursor:
        type: string
      limit:
        description: Max rows per response (capped at 100).
        maximum: 100
        minimum: 1
        type: integer
      page_id:
        description: "ULID of the page block, or its title or alias."
        type: string
      space_id:
        description: "ULID of the space the agent is operating in. The read is rejected with a Validation error if `page_id` lives in a different space."
        type: string
    required:
      - page_id
      - space_id
    type: object
  name: page_history
- description: "Who changed what on one block, and when. Each row has device_id, seq, origin (`user`, or `agent:<name>` for an agent's write), op_type, created_at (epoch ms), block_id, a clipped `after` (the text or property value the op wrote) and, for an edit, a clipped `before`. Newest first; cursor paginated."
  inputSchema:
    additionalProperties: false
    properties:
      block_id:
        description: ULID of the block.
        type: string
      cursor:
        type: string
      limit:
        description: Max rows per response (capped at 100).
        maximum: 100
        minimum: 1
        type: integer
      space_id:
        description: "ULID of the space the agent is operating in. The read is rejected with a Validation error if `block_id` lives in a different space."
        type: string
    required:
      - block_id
      - space_id
    type: object
  name: block_history
- description: "Read a day's journal page as Markdown, returned as { date, page_id, markdown } in the shape get_page_markdown returns. Never creates the day: a missing one returns `page_id: null` and empty `markdown`."
  inputSchema:
    additionalProperties: false
    properties:
      date:
        description: "`today` (the default), `yesterday`, or YYYY-MM-DD, on this device's clock."
        type: string
      space_id:
        description: ULID of the space the journal belongs to.
        type: string
    required:
      - space_id
    type: object
  name: get_journal
- description: "List the journal days of a space from `from` to `to` (inclusive), oldest first, each as { page_id, date, block_count }. Cursor paginated."
  inputSchema:
    additionalProperties: false
    properties:
      cursor:
        description: Opaque pagination cursor from a prior response.
        type: string
      from:
        description: "First day, YYYY-MM-DD."
        type: string
      limit:
        description: Max days per response (capped at 100).
        maximum: 100
        minimum: 1
        type: integer
      space_id:
        description: ULID of the space the journal belongs to.
        type: string
      to:
        description: "Last day, YYYY-MM-DD."
        type: string
    required:
      - space_id
      - from
      - to
    type: object
  name: list_journal
- description: "List the soft-deleted blocks of a space, newest deletion first, with cursor pagination. A block deleted with its parent is not listed: restoring the parent restores it. Pass a row's id and deleted_at to restore_block."
  inputSchema:
    additionalProperties: false
    properties:
      cursor:
        description: Opaque pagination cursor from a prior response.
        type: string
      limit:
        description: Max blocks per response (capped at 100).
        maximum: 100
        minimum: 1
        type: integer
      space_id:
        description: ULID of the space whose trash to list.
        type: string
    required:
      - space_id
    type: object
  name: list_trash
- description: "Look up page and tag names in a space, many in one call, as a written `[[Name]]` / `#name` is matched: a page by exact title, else by one case-insensitive title, else by alias; a tag by name, ignoring case. Each name answers `page_id` and `tag_id`, null when nothing matches; a name several pages share answers `page_candidates` instead. Tools that take a page or tag id take its name too, so this is only for ids up front."
  inputSchema:
    additionalProperties: false
    properties:
      names:
        description: The page or tag names to look up.
        items:
          type: string
        maxItems: 1000
        minItems: 1
        type: array
      space_id:
        description: ULID of the space to look in.
        type: string
    required:
      - names
      - space_id
    type: object
  name: resolve
- description: "Query one space's blocks with a boolean tree of predicates, optionally sorted, grouped and aggregated; cursor paginated. Rows carry `page_title` and the properties the query reads; with `group_by` the result is `groups` of { key, title, count, aggregates } instead. Open TODOs with estimate > 3: {\"space_id\": \"<ULID>\", \"where\": {\"type\": \"And\", \"children\": [{\"type\": \"Leaf\", \"primitive\": {\"type\": \"State\", \"values\": [\"TODO\"]}}, {\"type\": \"Leaf\", \"primitive\": {\"type\": \"HasProperty\", \"key\": \"estimate\", \"predicate\": {\"type\": \"Gt\", \"value\": {\"type\": \"Num\", \"value\": 3}}}}]}}"
  inputSchema:
    additionalProperties: false
    properties:
      aggregate:
        description: "[{op: count|sum|avg|min|max, target?: {type: Property, key} | {type: Column, name: priority|position}}], over the whole match and per group."
        type: array
      cursor:
        description: Opaque pagination cursor from a prior response.
        type: string
      group_by:
        description: "{type: Page|Tag|State|Priority|BlockType}, {type: Property, key} or {type: DateBucket, source: due|scheduled|created|lastEdited, unit: day|week|month}."
        type: object
      limit:
        description: Max rows or groups per response (capped at 100).
        maximum: 100
        minimum: 1
        type: integer
      sort:
        description: "[{source: {type: Column, name: created|lastEdited|position|priority|title}, desc?}]. Default: newest first."
        type: array
      space_id:
        description: ULID of the space to query.
        type: string
      where:
        description: "{type: And|Or, children: [...]}, {type: Not, child} or {type: Leaf, primitive}. Primitives: Tag {tag} (attached), TagOrRef {tag} (attached or inline), HasProperty {key, predicate}, State {values}, Priority {values}, BlockType {values, exclude}, DueDate {predicate}, Scheduled {predicate}, Created {after?, before?}, LastEdited {spec}, LinksTo {target}, LinkedFrom {source}, ChildOf {parent}, HasParentMatching {matcher: <where>}, PathGlob {pattern, exclude} (pages whose lower-case title matches the GLOB). Property predicate: Exists, NotExists, or Eq|Ne|Lt|Gt|Lte|Gte|Contains|StartsWith {value: {type: Text|Num|Date|Ref, value}}. Date predicate: IsNull, Before|After|OnOrBefore|OnOrAfter|On {date}, Between {from, to}. LastEdited spec: Rolling {days}, OlderThan {days}, Range {start, end}. Ids are ULIDs, dates YYYY-MM-DD."
        type: object
    required:
      - space_id
      - where
    type: object
  name: query
