  "query": "SELECT tag_id, name, usage_count, updated_at\n         FROM tags_cache\n         WHERE tag_id IN (\n             SELECT id FROM blocks\n             WHERE block_type = 'tag' AND space_id = ?1\n         )\n           AND (?2 IS NULL OR tag_id > ?3)\n         ORDER BY tag_id ASC\n         LIMIT ?4",
