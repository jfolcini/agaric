  "query": "SELECT a.id, a.block_id, a.mime_type, a.filename, a.size_bytes, a.fs_path, a.created_at, a.content_hash FROM attachments a JOIN blocks b ON b.id = a.block_id WHERE b.page_id = ?1 AND b.deleted_at IS NULL AND (?2 IS NULL OR a.id > ?2) ORDER BY a.id LIMIT ?3",
