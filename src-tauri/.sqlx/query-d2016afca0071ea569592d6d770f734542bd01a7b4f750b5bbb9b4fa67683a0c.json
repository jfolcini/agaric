  "query": "SELECT b.id AS \"id!\", b.content AS \"content!\",\n                      COALESCE(b.space_id, p.space_id) AS \"space?\"\n               FROM blocks b\n               LEFT JOIN blocks p ON p.id = b.page_id AND p.deleted_at IS NULL\n               WHERE b.deleted_at IS NULL AND b.content IS NOT NULL AND b.id IN (SELECT value FROM json_each(?))",
