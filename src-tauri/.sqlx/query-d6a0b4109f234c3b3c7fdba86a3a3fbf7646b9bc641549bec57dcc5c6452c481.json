  "query": "SELECT id AS \"id!\", page_id AS \"page_id!\", parent_id, position,\n                  CASE WHEN ltrim(content) LIKE '#%' THEN content ELSE '' END\n                      AS \"content!: String\"\n               FROM blocks\n               WHERE block_type = 'content'\n                 AND deleted_at IS NULL\n                 AND page_id IN (SELECT value FROM json_each(?1))",
