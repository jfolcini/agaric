# EditorConfig — repo-wide editor defaults for Agaric.
# Aligns with .oxfmtrc.json (2-space, LF) for JS/TS/JSON and rustfmt for Rust.
# Docs: https://editorconfig.org
root = true

# Defaults for all files: matches oxfmt's formatter (useTabs=false, tabWidth=2)
# and ensures Unix line endings + trimmed trailing whitespace across editors.
[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 2

# Rust: rustfmt defaults to 4-space indent.
[*.rs]
indent_size = 4

# Markdown: trailing spaces are significant (hard line breaks), so don't trim.
[*.md]
trim_trailing_whitespace = false

# Shell: shfmt reads its options from here, so its hook passes no flags (a
# flag on its command line makes it ignore this file).
[*.sh]
switch_case_indent = true
binary_next_line = true
