# Supply-chain hardening (issue #816 — "stay on npm").
#
# ignore-scripts=true blocks npm from running dependency lifecycle
# scripts (pre/post-install) on `npm ci` / `npm install`. A
# freshly-compromised release can no longer execute arbitrary code at
# install time. The dependencies that carry install scripts are esbuild and
# fsevents, which ship functional prebuilt binaries via optionalDependencies,
# and edgedriver and geckodriver (wdio's browser drivers; e2e-tauri drives the
# app through tauri-driver instead), so blocking their scripts is a no-op for
# the build. Explicit `npm run <script>` invocations are unaffected; only
# dependency lifecycle hooks are blocked.
#
# The root `postinstall` (playwright browser download) is removed from
# package.json — browsers are installed explicitly in scripts/setup.sh
# and the e2e CI job via `npx playwright install chromium`.
ignore-scripts=true

# min-release-age is in days: when npm resolves a version (`npm install`,
# `npm update`) it only considers versions published more than 7 days ago, so
# a release published minutes ago cannot be pulled in locally. Dependabot's
# cooldown (.github/dependabot.yml) covers its PRs, not this. `npm ci` installs
# the exact lockfile versions and is unaffected. `npm audit fix` refuses a fix
# younger than 7 days and exits non-zero; to take one now, run it with
# `--min-release-age=0`.
min-release-age=7

# engine-strict=true makes the `engines` range in package.json a hard
# gate: npm refuses to install under an unsupported Node/npm instead of
# warning.
#
# Because this is a HARD gate, `engines.node` is DERIVED from the
# dependency tree, not picked by hand: it is the intersection of every
# `engines.node` declared by an installed package. Today jsdom is the
# binding constraint at every boundary (it declares exactly the range we
# publish), with @babel/* 8.x excluding the whole Node 23 line. Re-derive
# it when those move — an over-tight range needlessly blocks installs, an
# over-loose one lets `npm ci` proceed onto a Node where a dependency
# genuinely breaks. Node 24 remains the development default (.nvmrc); the
# floor of the range is exercised weekly by `scheduled-deep-checks.yml`'s
# `full-suite` lane.
engine-strict=true
#
# `engines.npm` is the exception: it is a deliberate FLOOR (>=12.0.0), not
# derived from the dependency tree (no dependency declares an npm range). The
# maintainer decided to require npm 12 for its security changes; the
# `packageManager` field pins the exact npm every installer reads
# (scripts/require-npm.sh, .github/actions/setup-node). `npm run` is not gated
# by engines, so the scripts that skip `npm ci` call require-npm.sh themselves.
