{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/App.tsx",
    "src/lib/search-query/index.ts",
    "src/components/EmojiPicker/index.ts",
    "src/editor/markdown-parse.ts",
    "src/lib/keyboard-config.ts",
    "src/lib/tauri-mock/__tests__/conformance-fuzz-bridge.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["src/lib/bindings.ts"],
  "ignoreBinaries": ["taplo", "rustc", "adb"],
  "ignoreDependencies": [
    "tailwindcss",
    "markdownlint-cli2",
    "better-npm-audit",
    "license-checker",
    "tw-animate-css",
    "@wdio/local-runner"
  ],
  "ignoreExportsUsedInFile": true
}
