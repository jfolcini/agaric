  "name": "peer_ref_writes",
  "ops": [
    {
      "args": {
        "deviceName": "Desk",
        "peerId": "peer-new"
      },
      "command": "update_peer_name",
      "comment": "Sets the LOCAL override. `remote_device_name` is what the peer calls itself and must survive untouched — the two columns are deliberately separate.",
      "name": "name_a_peer",
      "via": "command"
    },
    {
      "args": {
        "deviceName": null,
        "peerId": "peer-old"
      },
      "command": "update_peer_name",
      "comment": "`peer-old` carries the override `Laptop`. A null name CLEARS it rather than storing an empty string. The op above is the other half: `peer-new` GAINS an override while its remote-supplied `Phone` survives untouched — the two columns are deliberately separate.",
      "name": "clear_a_peer_name",
      "via": "command"
    },
    {
      "args": {
        "address": "192.168.1.7:4433",
        "peerId": "peer-new"
      },
      "command": "set_peer_address",
      "comment": "`last_address` is opaque to the command — it validates the host:port SHAPE and stores the string; nothing resolves it here.",
      "name": "address_a_peer",
      "via": "command"
    },
    {
      "args": {
        "address": "nohost",
        "peerId": "peer-new"
      },
      "command": "set_peer_address",
      "comment": "No colon, so no port. Refused before the row is touched.",
      "expect_error": "validation",
      "name": "address_rejects_a_portless_host",
      "via": "command"
    },
    {
      "args": {
        "address": "host:0",
        "peerId": "peer-new"
      },
      "command": "set_peer_address",
      "comment": "Port 0 is not a usable port; the parse is a non-zero u16.",
      "expect_error": "validation",
      "name": "address_rejects_a_zero_port",
      "via": "command"
    },
    {
      "args": {
        "address": ":4433",
        "peerId": "peer-new"
      },
      "command": "set_peer_address",
      "comment": "A port with no host.",
      "expect_error": "validation",
      "name": "address_rejects_an_empty_host",
      "via": "command"
    },
    {
      "args": {
        "address": "192.168.1.7:80.0",
        "peerId": "peer-new"
      },
      "command": "set_peer_address",
      "comment": "The port is parsed by `u16::from_str`, which takes DIGITS only. `80.0`, ` 80`, `0x50` and `1e3` all coerce to a number in JS, so a mock using `Number` alone stores four addresses the backend refuses.",
      "expect_error": "validation",
      "name": "address_rejects_a_non_digit_port",
      "via": "command"
    },
    {
      "args": {
        "peerId": "peer-never"
      },
      "command": "delete_peer_ref",
      "comment": "Removes the row outright — `peer_refs` carries no tombstone.",
      "name": "delete_a_peer",
      "via": "command"
    },
    {
      "args": {
        "peerId": "peer-ghost"
      },
      "command": "delete_peer_ref",
      "comment": "A missing peer is NotFound, not a silent no-op: the three writers agree on that.",
      "expect_error": "not_found",
      "name": "delete_an_unknown_peer_is_not_found",
      "via": "command"
    },
    {
      "args": {
        "deviceName": "X",
        "peerId": "peer-ghost"
      },
      "command": "update_peer_name",
      "comment": "Same rule on the rename path.",
      "expect_error": "not_found",
      "name": "name_an_unknown_peer_is_not_found",
      "via": "command"
    },
    {
      "args": {
        "address": "h:1",
        "peerId": "peer-ghost"
      },
      "command": "set_peer_address",
      "comment": "Same rule on the address path — and note it is checked AFTER the shape validation above, so a bad address on an unknown peer is a validation refusal, not this one.",
      "expect_error": "not_found",
      "name": "address_an_unknown_peer_is_not_found",
      "via": "command"
    }
  ],
  "queries": [
    {
      "args": {},
      "command": "list_peer_refs",
      "comment": "The observation. `peer-new` carries both writes and keeps the `Phone` its peer supplied, `peer-old` has its local override cleared, and `peer-never` is gone.",
      "name": "peers_after_writes"
    }
