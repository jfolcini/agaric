  "name": "batch_writes",
  "ops": [
    {
      "args": {
        "specs": [
          {
            "blockType": "content",
            "content": "first",
            "parentId": "S1",
            "position": 4
          },
          {
            "blockType": "content",
            "content": "second",
            "parentId": "S1",
            "position": 5
          },
          {
            "blockType": "content",
            "content": "nested",
            "parentId": "S2"
          }
        ]
      },
      "command": "create_blocks_batch",
      "comment": "Three specs in one transaction. The return is a LIST, so the order the rows come back in is pinned alongside each row's parent and position — a batch that creates the right blocks in the wrong order reds here and nowhere else, since the settled snapshot sorts.",
      "name": "create_three_blocks",
      "via": "command"
    },
    {
      "args": {
        "specs": [
          {
            "blockType": "content",
            "content": "todo item",
            "parentId": "S1",
            "properties": {
              "todo_state": "TODO"
            }
          },
          {
            "blockType": "content",
            "content": "ranked item",
            "parentId": "S1",
            "properties": {
              "priority": "1"
            }
          }
        ]
      },
      "command": "create_blocks_batch",
      "comment": "A spec's `properties` map expands to a SetProperty op per entry inside the same transaction, so the digest moves by more than one per block created. ONE property per spec deliberately: the map is a `HashMap` on the Rust side, so two entries in one spec would leave the op ORDER to hash iteration and the authored `expected` would pin a run rather than a contract.",
      "name": "create_block_with_properties",
      "via": "command"
    },
    {
      "args": {
        "blockIds": ["S3", "S4"],
        "newIndex": 0,
        "newParentId": "S2"
      },
      "command": "move_blocks_batch",
      "comment": "Two blocks to a new parent in one call. The returned rows carry each block's NEW parent and position, so a batch that reports the requested index rather than the slot it actually landed in reds.",
      "name": "move_two_blocks",
      "via": "command"
    },
    {
      "args": {
        "blockIds": ["S3", "S4"],
        "state": "DOING"
      },
      "command": "set_todo_state_batch",
      "comment": "The bare count is the whole return value. Before #5057 this projected to the command name alone, so the number was invisible to the harness.",
      "name": "todo_state_on_two_blocks",
      "via": "command"
    },
    {
      "args": {
        "blockIds": ["S3", "C4"],
        "state": "DONE"
      },
      "command": "set_todo_state_batch",
      "comment": "C4 is the block `create_block_with_properties` made, so a later op can name it exactly as it names a seed row. Both ids are live, so both count — the count is rows AFFECTED, which the idempotent tag op below separates from ids passed.",
      "name": "todo_state_counts_an_op_created_block",
      "via": "command"
    },
    {
      "args": {
        "blockIds": ["S3"],
        "state": null
      },
      "command": "set_todo_state_batch",
      "comment": "A null state CLEARS. The op still carries the key, so the clear is visible in the digest rather than being a silent no-op.",
      "name": "clear_todo_state",
      "via": "command"
    },
    {
      "args": {
        "blockIds": ["S3", "S4"],
        "key": "priority",
        "value": "2"
      },
      "command": "set_property_batch",
      "comment": "`set_property_batch` routes a reserved key to its value column; `priority` is value_text, and its vocabulary is \"1\"/\"2\"/\"3\" — a stack that accepts an org-mode-style \"A\" here diverges.",
      "name": "priority_on_two_blocks",
      "via": "command"
    },
    {
      "args": {
        "blockIds": ["S4"],
        "key": "due_date",
        "value": "2026-03-01"
      },
      "command": "set_property_batch",
      "comment": "A different column for the same command — `due_date` routes to value_date, so a mock that writes every batch property as text diverges in the snapshot.",
      "name": "due_date_is_a_date_column",
      "via": "command"
    },
    {
      "args": {
        "blockIds": ["S3"],
        "key": "colour",
        "value": "red"
      },
      "command": "set_property_batch",
      "comment": "Only the four reserved column-backed keys are settable in batch. The refusal happens BEFORE the transaction opens, so nothing is written.",
      "expect_error": "validation",
      "name": "set_property_batch_refuses_an_unlisted_key",
      "via": "command"
    },
    {
      "args": {
        "blockIds": ["S3", "S4"],
        "tagId": "S5"
      },
      "command": "add_tags_by_ids",
      "comment": "The count is blocks NEWLY tagged.",
      "name": "tag_two_blocks",
      "via": "command"
    },
    {
      "args": {
        "blockIds": ["S3", "S4"],
        "tagId": "S5"
      },
      "command": "add_tags_by_ids",
      "comment": "Both are already tagged, so nothing is newly tagged and the count is 0 — the arm that separates 'rows newly tagged' from 'ids passed'.",
      "name": "tagging_again_is_idempotent",
      "via": "command"
    },
    {
      "args": {
        "specs": []
      },
      "command": "create_blocks_batch",
      "comment": "An empty batch is a caller bug on this path too.",
      "expect_error": "validation",
      "name": "create_blocks_batch_refuses_an_empty_list",
      "via": "command"
    },
    {
      "args": {
        "blockIds": [],
        "newIndex": 0,
        "newParentId": "S1"
      },
      "command": "move_blocks_batch",
      "comment": "Same guard.",
      "expect_error": "validation",
      "name": "move_blocks_batch_refuses_an_empty_list",
      "via": "command"
    },
    {
      "args": {
        "blockIds": [],
        "state": "TODO"
      },
      "command": "set_todo_state_batch",
      "comment": "Same guard.",
      "expect_error": "validation",
      "name": "set_todo_state_batch_refuses_an_empty_list",
      "via": "command"
    },
    {
      "args": {
        "blockIds": [],
        "tagId": "S5"
      },
      "command": "add_tags_by_ids",
      "comment": "Same guard.",
      "expect_error": "validation",
      "name": "add_tags_by_ids_refuses_an_empty_list",
      "via": "command"
    }
  ],
