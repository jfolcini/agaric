# Tauri
src-tauri/target/
src-tauri/gen/
# cargo-fuzz (#650): build tree + libFuzzer crash artifacts are generated;
# the targets, Cargo.toml/lock, and seed corpora under fuzz/ stay tracked.
src-tauri/fuzz/target/

src-tauri/fuzz/artifacts/

# Generated per-target copies of bundled external binaries (see
# scripts/prepare-external-bins.mjs + tauri.conf.json → externalBin).
src-tauri/binaries/

# Python bytecode cache — appears whenever a hook script under
# scripts/ gets imported (e.g. ad-hoc instrumentation of
# check-raw-tx.py); must never ride along on a `git add -A`.
__pycache__/

# check-hook-deps.mjs's CLI self-test fixture tree. It has to live inside the
# repo's own scripts/ (Node resolves the `smol-toml` bare specifier by walking
# the IMPORTING file's ancestors for node_modules), and its `finally` cleanup
# does not survive a hard kill. The self-test also sweeps stale ones at
# start-up; this rule covers the window in between, so a stranded tree can
# never ride along on a `git add -A` — same reasoning as __pycache__ above.
scripts/.hookdeps-cli-selftest-*/

# SQLx dev database (offline cache .sqlx/ is tracked)
src-tauri/dev.db
src-tauri/dev.db-*
# Per-member sqlx dev databases (agaric-engine / agaric-store carry their own
# `.sqlx` offline cache + a `../migrations` symlink; the CI sqlx-prepare lanes
# create these fresh, so they are local build artifacts — never committed).
src-tauri/agaric-engine/dev.db
src-tauri/agaric-engine/dev.db-*
src-tauri/agaric-store/dev.db
src-tauri/agaric-store/dev.db-*
src-tauri/.env
coverage/
# vitest json-summary/json coverage output (CI's "Vitest (full suite, with
# coverage)" step writes here via --coverage.reportsDirectory; consumed as
# an artifact + by the "Coverage summary" step; local runs leave it in the
# tree). Was per-shard output merged by the now-deleted
# scripts/merge-vitest-coverage.mjs before the 3-shard vitest split was
# consolidated into one full-suite run (#3258).
coverage-merged/
# Rust llvm-cov outputs (cargo llvm-cov writes them under src-tauri/).
src-tauri/coverage.lcov
src-tauri/coverage-summary.json

# Playwright
test-results/
playwright-report/
blob-report/

# Lychee link-check cache (generated by `lychee --cache`; persisted in CI via actions/cache)
.lycheecache

# Stryker mutation testing (#886) — sandbox copy + generated reports
.stryker-tmp/
reports/mutation/

# Type-aware lint lane (#4408) — the `oxlint --type-aware` JSON report and the
# generated canary fixture `scripts/check-type-aware-liveness.mjs` writes here.
# It lives inside the repo because oxlint resolves the tsgolint binary from the
# working directory's node_modules, so a fixture in the system temp dir cannot
# find it.
reports/type-aware/
worktrees/
UNDO-REDO-PLAN.md
agaric-release.apk
agaric-release.apk.idsig

# Claude Code runtime state (per-machine; settings.json + hooks/ are tracked)
.claude/scheduled_tasks.lock
.claude/settings.local.json
# WDIO rescues the app's own logs here so a red run keeps the backend's account
# of itself (#4428). The rotated name `agaric.log.<date>` does NOT match the
# `*.log` rule above, so without this an ordinary local run leaves an untracked
# file a bare `git add -A` would sweep into a commit (#3731).
e2e-tauri/artifacts/

# Ephemeral review/workflow scratch artifacts (per-machine, never committed)
.claude/confirmed.json
.claude/create-review-issues.py
.claude/issue-creation*
.claude/review*.json
.claude/verify_results.json
.claude/wf-*.js
.claude/scratch/
# Added by code-review-graph
.code-review-graph/

# Serena MCP server per-project cache/state
.serena/

# Per-machine active cargo config (the staged `.example` is tracked;
# activating it makes the build depend on host-installed mold).
# NOTE: this must stay pinned to `config.toml` — `src-tauri/.cargo/mutants.toml`
# is TRACKED and load-bearing (it is the only path cargo-mutants reads its
# config from, #3386), as is `src-tauri/.cargo/audit.toml`.
.cargo/config.toml

# cargo-mutants output. `--in-place` writes these into the source tree, and
# each run renames the previous one to `mutants.out.old` (#3386).
mutants.out/
mutants.out.old/
